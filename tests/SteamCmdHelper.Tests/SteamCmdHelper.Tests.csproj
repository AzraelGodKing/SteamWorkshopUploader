<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The app is a Windows Forms exe, so these tests compile the non-UI source files directly instead of
    referencing it. That keeps them runnable with plain "dotnet test" on any OS.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>SteamCmdHelper.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../ModScanner.cs;../../ProjectConfig.cs;../../RequestSender.cs;../../BakedRequestKey.cs;../../Publisher.cs;../../SteamCmdIntegrity.cs;../../SteamCmdOutput.cs;../../SteamLogin.cs;../../UploadedVersions.cs;../../BatchUpload.cs;../../Cli.cs;../../UpdateCheck.cs;../../WorkshopPage.cs;../../UploadHistory.cs;../../WorkshopStatus.cs;../../ModRows.cs;../../ModDetails.cs;../../AppSettings.cs;../../SelfUpdate.cs;../../AppUpdates.cs;../../CrashReport.cs;../../PackageCheck.cs;../../GitOps.cs;../../Announce.cs;../../Dependencies.cs;../../SubscriberStats.cs;../../Display.cs;../../PreviewImage.cs;../../PreviewCache.cs;../../PackageManifest.cs;../../ChangeNotes.cs;../../DescriptionSync.cs;../../BuildStep.cs;../../RunLogs.cs;../../WorkshopTags.cs;../../SteamCmd.cs;../../GameBuilds.cs;../../WorkshopDownload.cs;../../TestInstall.cs;../../GitHubActions.cs;../../SettingsTransfer.cs;../../WhatsNew.cs;../../WorkshopExtras.cs;../../RimWorldLint.cs;../../WorkshopStats.cs;../../NewMod.cs;../../Localizer.cs;../../Thunderstore.cs;../../SecretScan.cs;../../SteamText.cs;../../ImageHeader.cs;../../GameVersions.cs;../../VersionBatch.cs;../../PaletteSearch.cs;../../Reports.cs;../../PackageArchive.cs;../../AfterUpload.cs;../../Doctor.cs;../../ScheduledUploads.cs;../../SteamRestart.cs;../../LaunchPad.cs;../../RimWorldXmlLint.cs;../../SettingsBackups.cs" Link="App/%(Filename)%(Extension)" />
    <!-- The game modules behind the RimWorld tools: all of it, so nothing there can lean on WinForms. -->
    <Compile Include="../../Games/**/*.cs" Link="Games/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../Languages/*.json" LogicalName="SteamCmdHelper.Languages.%(Filename).json" />
    <EmbeddedResource Include="../../CHANGELOG.md" LogicalName="SteamCmdHelper.CHANGELOG.md" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- PreviewImage uses GDI+, so its tests run on Windows only (the Windows CI job). -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
    <!-- AppUpdates (compiled in above) uses it. -->
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
</Project>
